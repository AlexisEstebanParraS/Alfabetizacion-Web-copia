# Servidor
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=municipio-facil

# Autenticación (JWT_SECRET es obligatorio: sin él el servidor no inicia)
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_con_una_cadena_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRES_IN=2h

# Origen del frontend permitido por CORS (protocolo + host + puerto)
# Desarrollo: http://localhost:5173 · Docker: http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173

# Servicio externo: correo de bienvenida con Resend (opcional; vacío = no se envía)
RESEND_API_KEY=
CORREO_REMITENTE="Municipio Fácil <onboarding@resend.dev>"

# Primer administrador (solo para: npm run crear-admin; bórralos después)
# Usa comillas si la contraseña tiene # (sin comillas, # inicia un comentario)
ADMIN_NOMBRE=Coordinador Municipal
ADMIN_EMAIL=admin@municipiofacil.cl
ADMIN_PASSWORD="Cambia#Esta1"

# Contraseña de las cuentas de ejemplo de "npm run datos-demo" (solo desarrollo)
DEMO_PASSWORD="Demo#2026"
